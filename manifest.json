{
  "manifest_version": 3,
  "name": "alphaXiv Citation Counts",
  "version": "1.12.0",
  "description": "Adds Semantic Scholar citation counts to alphaXiv papers and citation hover cards.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.semanticscholar.org/*",
    "https://alphaxiv.org/*",
    "https://www.alphaxiv.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://alphaxiv.org/*", "https://www.alphaxiv.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "alphaXiv Citation Counts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
